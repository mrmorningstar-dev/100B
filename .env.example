# ==============================================================================
# YouTube Channel Automation — Environment Variables
# Rename this file to .env and fill in your API credentials.
# ==============================================================================

# Google AI Studio API Key (14,000 free requests/day for Gemini / Gemma)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Anthropic Claude API Key (Optional alternative)
ANTHROPIC_API_KEY=

# Reddit API Credentials (Phase 2 Scraper - Optional for open feeds, required for PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:funny_video_curator:v1.0 (by /u/YOUR_USERNAME)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# X (Twitter) Optional Cookies
TWITTER_COOKIES_PATH=cookies.txt


