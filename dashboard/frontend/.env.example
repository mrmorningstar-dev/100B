# ==============================================================================
# 100B Dashboard Frontend — Environment Configuration
# ==============================================================================

# Backend API URL (Direct CORS deployment via Cloudflare Tunnel)
# Set this in your Vercel project Environment Variables to point to your Cloudflare Tunnel.
# Example: https://tunnel.yourdomain.com
# Leave blank for local development (uses Vite proxy to http://127.0.0.1:8765).
# NOTE: Never store DASHBOARD_API_KEY in frontend env vars. Authentication is entered
# interactively by the user via the unlock modal and stored only in sessionStorage.
VITE_API_BASE_URL=
